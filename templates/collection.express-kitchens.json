{
  "sections": {
    "collection-banner": {
      "type": "collection-banner",
      "settings": {
        "color_scheme": "scheme-4",
        "image_size": "sm",
        "allow_transparent_header": true,
        "show_collection_description": true,
        "show_collection_image": true,
        "mobile_text_position": "place-self-center text-center",
        "desktop_text_position": "sm:place-self-center-start sm:text-start",
        "overlay_color": "#000000",
        "overlay_opacity": 25
      }
    },
    "express-info": {
      "type": "rich-text",
      "blocks": {
        "heading-1": {
          "type": "heading",
          "settings": {
            "text": "Express Kitchens — Ready in 48 Hours",
            "heading_tag": "h2"
          }
        },
        "richtext-1": {
          "type": "richtext",
          "settings": {
            "content": "<p>Pre-configured kitchen sets delivered and assembled within 48 hours. No waiting, no hassle.</p>"
          }
        }
      },
      "block_order": ["heading-1", "richtext-1"],
      "settings": {
        "color_scheme": "scheme-1",
        "separate_section_with_border": false,
        "content_width": "md",
        "text_position": "center"
      }
    },
    "main": {
      "type": "main-collection",
      "settings": {
        "color_scheme": "scheme-1",
        "products_per_page": 24,
        "products_per_row_mobile": "2",
        "products_size_desktop": "medium",
        "show_grid_mode_selector": false
      }
    },
    "trust-bar": {
      "type": "text-with-icons",
      "blocks": {
        "icon-1": {
          "type": "item",
          "settings": {
            "title": "48-hour delivery"
          }
        },
        "icon-2": {
          "type": "item",
          "settings": {
            "title": "Free assembly included"
          }
        },
        "icon-3": {
          "type": "item",
          "settings": {
            "title": "5-year warranty"
          }
        }
      },
      "block_order": ["icon-1", "icon-2", "icon-3"],
      "settings": {}
    }
  },
  "order": ["collection-banner", "express-info", "main", "trust-bar"]
}
